# ------------------------------------------------------------------------------
# ForgeOS environment
#
# EVERY VARIABLE BELOW IS OPTIONAL. With an empty environment ForgeOS runs in
# "local mode": file-backed storage under .forgeos/, a deterministic offline AI
# provider, and a single local workspace owner. Setting a variable upgrades the
# corresponding subsystem at boot — no code changes, no rebuild.
#
# Inspect what is active at any time:  GET /api/system/health
# ------------------------------------------------------------------------------

# --- Storage ------------------------------------------------------------------
# Unset            -> file adapter (.forgeos/), zero setup.
# postgres://...   -> PostgreSQL adapter. Enable the `vector` extension for
#                     pgvector-backed semantic memory; ForgeOS falls back to
#                     exact cosine scoring in SQL when it is unavailable.
DATABASE_URL=
FORGEOS_DATA_DIR=.forgeos

# --- AI -----------------------------------------------------------------------
# Unset            -> the deterministic `forge-local` provider. Fully offline,
#                     grounded in real repository analysis, costs nothing.
# Set              -> OpenRouter is registered alongside forge-local.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FORGEOS_DEFAULT_MODEL=forge-local

# --- Authentication -----------------------------------------------------------
# Unset            -> local single-user session (development only).
# Set              -> Clerk is used for identity and the local session is refused.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Caching / rate limiting --------------------------------------------------
# Unset            -> in-process LRU + token bucket (per instance).
REDIS_URL=

# --- Background jobs ----------------------------------------------------------
# Unset            -> jobs run inline in the request with a bounded queue.
TRIGGER_SECRET_KEY=

# --- Secrets ------------------------------------------------------------------
# 32+ byte random string used to encrypt stored integration credentials at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FORGEOS_ENCRYPTION_KEY=

# --- Misc ---------------------------------------------------------------------
FORGEOS_LOG_LEVEL=info
NEXT_PUBLIC_FORGEOS_URL=http://localhost:3000
